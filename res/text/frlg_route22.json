{
  "key": 9615,
  "messages": [
    {
      "id": "Route22_Text_EarlyRivalIntro",
      "en_US": [
        "{STRVAR_1 3, 1, 0}: Hey! {STRVAR_1 3, 0, 0}!\r",
        "You’re off to the Pokémon League?\n",
        "Forget about it!\r",
        "You probably don’t have any\n",
        "Badges, do you?\r",
        "The guard won’t let you through\n",
        "without them.\r",
        "By the way, did your Pokémon get\n",
        "any stronger?"
      ]
    },
    {
      "id": "Route22_Text_EarlyRivalDefeat",
      "en_US": [
        "Awww!\n",
        "You just lucked out!"
      ]
    },
    {
      "id": "Route22_Text_EarlyRivalPostBattle",
      "en_US": [
        "I heard the Pokémon League is\n",
        "crawling with tough Trainers.\r",
        "I have to figure out how to get\n",
        "past them.\r",
        "You should quit dawdling and get a\n",
        "move on!"
      ]
    },
    {
      "id": "Route22_Text_LateRivalIntro",
      "en_US": [
        "{STRVAR_1 3, 1, 0}: What? {STRVAR_1 3, 0, 0}!\n",
        "What a surprise to see you here!\r",
        "So you’re going to the Pokémon\n",
        "League?\r",
        "You collected all the Badges, too?\n",
        "That’s cool!\r",
        "Then I’ll whip you, {STRVAR_1 3, 0, 0}, as a\n",
        "warm-up for the Pokémon League!\r",
        "Come on!"
      ]
    },
    {
      "id": "Route22_Text_LateRivalDefeat",
      "en_US": [
        "What!?\r",
        "I was just careless, you!"
      ]
    },
    {
      "id": "Route22_Text_LateRivalPostBattle",
      "en_US": [
        "That loosened me up.\n",
        "I’m ready for the Pokémon League!\r",
        "{STRVAR_1 3, 0, 0}, you need more practice.\r",
        "But hey, you know that!\n",
        "I’m out of here. Smell ya!"
      ]
    },
    {
      "id": "Route22_Text_LeagueGateSign",
      "en_US": [
        "Pokémon League\n",
        "Front Gate"
      ]
    }
  ]
}
