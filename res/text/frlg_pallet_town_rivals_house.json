{
  "key": 5273,
  "messages": [
    {
      "id": "PalletTown_RivalsHouse_Text_HiBrothersAtLab",
      "en_US": [
        "Daisy: Hi, {STRVAR_1 3, 0, 0}!\r",
        "My brother, {STRVAR_1 3, 1, 0}, is out at\n",
        "Grandpa’s Lab."
      ]
    },
    {
      "id": "PalletTown_RivalsHouse_Text_HeardYouBattledRival",
      "en_US": [
        "Daisy: {STRVAR_1 3, 0, 0}, I heard you had\n",
        "a battle against {STRVAR_1 3, 1, 0}.\r",
        "I wish I’d seen that!"
      ]
    },
    {
      "id": "PalletTown_RivalsHouse_Text_ErrandForGrandpaThisWillHelp",
      "en_US": [
        "Grandpa asked you to run an\n",
        "errand?\r",
        "Gee, that’s lazy of him.\n",
        "Here, this will help you."
      ]
    },
    {
      "id": "PalletTown_RivalsHouse_Text_ReceivedTownMapFromDaisy",
      "en_US": [
        "{STRVAR_1 3, 0, 0} received a Town Map\n",
        "from Daisy."
      ]
    },
    {
      "id": "PalletTown_RivalsHouse_Text_DontHaveSpaceForThis",
      "en_US": [
        "You don’t have space for this in\n",
        "your Bag."
      ]
    },
    {
      "id": "PalletTown_RivalsHouse_Text_ExplainTownMap",
      "en_US": [
        "You can use the Town Map to find\n",
        "out where you are, or check the\f",
        "names of places."
      ]
    },
    {
      "id": "PalletTown_RivalsHouse_Text_PleaseGiveMonsRest",
      "en_US": [
        "Daisy: Just like people, Pokémon\n",
        "are living things.\r",
        "When they get tired, please give\n",
        "them a rest."
      ]
    },
    {
      "id": "PalletTown_RivalsHouse_Text_ItsBigMapOfKanto",
      "en_US": [
        "It’s a big map of the Kanto region.\n",
        "Now this would be useful!"
      ]
    },
    {
      "id": "PalletTown_RivalsHouse_Text_ShelvesCrammedFullOfBooks",
      "en_US": [
        "The shelves are crammed full of\n",
        "books on Pokémon."
      ]
    },
    {
      "id": "PalletTown_RivalsHouse_Text_LikeMeToGroomMon",
      "en_US": [
        "Daisy: Hi, {STRVAR_1 3, 0, 0}!\n",
        "Good timing.\r",
        "I’m about to have some tea.\n",
        "Would you like to join me?\r",
        "Oh, but look.\n",
        "Your Pokémon are a little dirty.\r",
        "Would you like me to groom one?"
      ]
    },
    {
      "id": "PalletTown_RivalsHouse_Text_DontNeedAnyGrooming",
      "en_US": [
        "You don’t need any grooming done?\n",
        "Okay, we’ll just have tea."
      ]
    },
    {
      "id": "PalletTown_RivalsHouse_Text_GroomWhichOne",
      "en_US": "Which one should I groom?"
    },
    {
      "id": "PalletTown_RivalsHouse_Text_LookingNiceInNoTime",
      "en_US": [
        "Daisy: Okay, I’ll get it looking\n",
        "nice in no time."
      ]
    },
    {
      "id": "PalletTown_RivalsHouse_Text_ThereYouGoAllDone",
      "en_US": [
        "{STRVAR_1 1, 2, 0} looks dreamily content…\r",
        "Daisy: There you go! All done.\n",
        "{STRVAR_1 1, 2, 0} looks dreamily content…\r",
        "Daisy: There you go! All done.\n",
        "See? Doesn’t it look nice?\r",
        "Giggle…\n",
        "It’s such a cute Pokémon."
      ]
    },
    {
      "id": "PalletTown_RivalsHouse_Text_CantGroomAnEgg",
      "en_US": [
        "Oh, sorry. I honestly can’t\n",
        "groom an Egg."
      ]
    },
    {
      "id": "PalletTown_RivalsHouse_Text_MayISeeFirstMon",
      "en_US": [
        "Daisy: Your Pokémon grow to love\n",
        "you if you raise them with love.\r",
        "For example, {STRVAR_1 3, 0, 0}, may I see\n",
        "your first Pokémon?"
      ]
    },
    {
      "id": "PalletTown_RivalsHouse_Text_CouldntLoveYouMore",
      "en_US": [
        "It couldn’t possibly love you\n",
        "any more than it does now.\r",
        "Your Pokémon is happy beyond\n",
        "words."
      ]
    },
    {
      "id": "PalletTown_RivalsHouse_Text_ItLooksVeryHappy",
      "en_US": [
        "It looks very happy.\r",
        "I wish {STRVAR_1 3, 1, 0} could see this and\n",
        "learn something from it."
      ]
    },
    {
      "id": "PalletTown_RivalsHouse_Text_ItsQuiteFriendly",
      "en_US": [
        "It’s quite friendly with you.\n",
        "Keep being good to it!"
      ]
    },
    {
      "id": "PalletTown_RivalsHouse_Text_ItsWarmingUpToYou",
      "en_US": [
        "It’s warming up to you.\n",
        "Trust must be growing between you."
      ]
    },
    {
      "id": "PalletTown_RivalsHouse_Text_NotFamiliarWithYouYet",
      "en_US": [
        "It’s not quite familiar with you\n",
        "yet.\r",
        "Pokémon are all quite wary when\n",
        "you first get them."
      ]
    },
    {
      "id": "PalletTown_RivalsHouse_Text_DontLikeWayItGlaresAtYou",
      "en_US": [
        "{STRVAR_1 3, 0, 0}, I don’t like the way it\n",
        "glares at you.\r",
        "Could you try being a little nicer\n",
        "to it?"
      ]
    },
    {
      "id": "PalletTown_RivalsHouse_Text_WhyWouldMonHateYouSoMuch",
      "en_US": [
        "…Um, it’s not easy for me to say\n",
        "this, but…\r",
        "Is there some reason why your\n",
        "Pokémon would hate you so much?"
      ]
    },
    {
      "id": "PalletTown_RivalsHouse_Text_LovelyAndSweetClefairy",
      "en_US": [
        "“The lovely and sweet\n",
        "Clefairy”"
      ]
    }
  ]
}
