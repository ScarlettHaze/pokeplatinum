  "messages": [
    {
      "id": "PewterCity_House2_Text_MonsLearnTechniquesAsTheyGrow",
      "en_US": [
        "Pokémon learn new techniques as\n",
        "they grow.\r",
        "But some moves must be taught to\n",
        "them by people."
      ]
    },
    {
      "id": "PewterCity_House2_Text_MonsEasierCatchIfStatused",
      "en_US": [
        "A Pokémon becomes easier to \n",
        "catch if it has a status problem.\r",
        "Sleep, poison, burn, or paralysis…\n",
        "Those are all effective.\r",
        "But catching Pokémon is never\n",
        "a sure thing!"
      ]
    }
  ]
}
